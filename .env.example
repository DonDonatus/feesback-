# Node Mode: "local" or "cloud"
NODE_TYPE=local

# Database Connection URL:
# For Local: sqlite:///./data/local.db
# For Cloud: postgresql+psycopg://postgres:password@localhost:5432/managesys_cloud
DATABASE_URL=sqlite:///./data/local.db

# Cloud Sync Settings (used by Local node to talk to Cloud node)
SYNC_REMOTE_URL=http://localhost:8001
SYNC_AUTH_TOKEN=secret-sync-token-12345

# Hubtel Payment Gateway Configuration
HUBTEL_CLIENT_ID=your_hubtel_client_id
HUBTEL_CLIENT_SECRET=your_hubtel_client_secret
HUBTEL_MERCHANT_ACCOUNT_NUMBER=your_merchant_account_number
HUBTEL_CALLBACK_URL=http://your-cloud-ip:8000/payments/hubtel/callback
HUBTEL_SANDBOX=true
